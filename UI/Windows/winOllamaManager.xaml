<Window x:Class="VPetLLM.UI.Windows.winOllamaManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:utils="clr-namespace:VPetLLM.Utils.Localization"
        xmlns:controls="clr-namespace:VPetLLM.UI.Controls"
        Title="{utils:Localize KeyPath=OllamaManager.Title, Default=一键化本地部署}"
        Width="1120"
        Height="720"
        MinWidth="720"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/QuickSetup.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ModernTextBox 的内边距会算两次，单行输入框要收一半才不会撑到 50 多像素 -->
            <Style x:Key="OllamaTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
                <Setter Property="Padding" Value="6,4"/>
            </Style>

            <Style x:Key="OllamaComboBox" TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}">
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="OllamaFitBadge" TargetType="TextBlock" BasedOn="{StaticResource QuickHint}">
                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Fit}" Value="Slow">
                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Fit}" Value="TooLarge">
                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="OllamaPanel" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SecondaryBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="12"/>
            </Style>

            <!-- 卡片排成网格时 CardContainer 的阴影太重，只留边框 -->
            <Style x:Key="OllamaModelCard" TargetType="Border" BasedOn="{StaticResource OllamaPanel}">
                <Setter Property="Padding" Value="14,14,14,12"/>
                <Setter Property="Margin" Value="0,0,12,12"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource HoverBorderBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 推荐的、正在用的那张卡 -->
            <Style x:Key="OllamaHighlightCard" TargetType="Border" BasedOn="{StaticResource OllamaModelCard}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Highlighted}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="OllamaStatLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            </Style>

            <Style x:Key="OllamaStatValue" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            </Style>

            <DataTemplate x:Key="OllamaCardHeader">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource BackgroundBrush}">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Initial}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource OllamaStatValue}" Margin="0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Name}" Text="{Binding Name}"/>
                        <TextBlock Style="{StaticResource OllamaFitBadge}" Margin="0,3,0,0" MinHeight="16" Text="{Binding Badge}"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="OllamaCardPanel">
                <UniformGrid VerticalAlignment="Top" Columns="{Binding CardGridColumns, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </ItemsPanelTemplate>

            <!-- 盖在输入框上，Tag 指向那个输入框 -->
            <Style x:Key="OllamaPlaceholder" TargetType="TextBlock">
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Margin" Value="16,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag.Text, RelativeSource={RelativeSource Self}}" Value="">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="OllamaFilterTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,12,0,8"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            </Style>

            <Style x:Key="OllamaChip" TargetType="Button">
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                <Setter Property="Background" Value="{StaticResource SecondaryBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource HoverBorderBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="OllamaFilterChip" TargetType="Button" BasedOn="{StaticResource OllamaChip}">
                <Setter Property="Margin" Value="0,0,6,6"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Selected}" Value="True">
                        <Setter Property="Background" Value="{StaticResource QuickSelectedBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="OllamaSegment" TargetType="RadioButton">
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="{StaticResource SecondaryBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="OllamaChipTemplate">
                <Button Style="{StaticResource OllamaFilterChip}" IsEnabled="{Binding CanPick}" Tag="{Binding}" Click="FilterChip_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Text}"/>
                        <Border Margin="6,0,0,0" Padding="5,0" CornerRadius="4" Background="{StaticResource BackgroundBrush}">
                            <TextBlock FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Count}"/>
                        </Border>
                    </StackPanel>
                </Button>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="OllamaChipPanel">
                <WrapPanel/>
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource QuickTitle}" Margin="0,0,0,8"
                   Text="{utils:Localize KeyPath=OllamaManager.Title, Default=一键化本地部署}"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock x:Name="Tb_Hardware" Style="{StaticResource QuickHint}"/>
            <TextBlock x:Name="Tb_Capacity" Style="{StaticResource QuickGuideLine}" Margin="0,3,0,0"/>
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="2" Style="{StaticResource ModernTabControl}"
                    ItemContainerStyle="{StaticResource ModernTabItem}" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="{utils:Localize KeyPath=OllamaManager.TabDeploy, Default=部署}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" controls:SmoothWheelScroll.Enabled="True">
                    <StackPanel VerticalAlignment="Top">
                    <Border Style="{StaticResource CardContainer}" Margin="0,12,8,4" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock x:Name="Tb_State" Style="{StaticResource QuickCardTitle}"/>
                            <TextBlock x:Name="Tb_Version" Style="{StaticResource QuickHint}"/>
                            <TextBlock x:Name="Tb_Plan" Style="{StaticResource QuickGuideLine}" Margin="0,12,0,0"/>
                            <TextBlock x:Name="Tb_SlowWarning" Style="{StaticResource QuickHint}" Margin="0,6,0,0"
                                       Foreground="{StaticResource WarningBrush}" Visibility="Collapsed"/>
                            <WrapPanel x:Name="Panel_Actions" Margin="0,16,0,0">
                                <Button x:Name="Btn_Deploy" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Click="Deploy_Click"
                                        Content="{utils:Localize KeyPath=OllamaManager.Deploy, Default=一键部署}"/>
                                <Button x:Name="Btn_Install" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="Install_Click"/>
                                <Button x:Name="Btn_Start" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="Start_Click"
                                        Content="{utils:Localize KeyPath=OllamaManager.Start, Default=启动服务}"/>
                                <Button x:Name="Btn_Refresh" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="Refresh_Click"
                                        Content="{utils:Localize KeyPath=OllamaManager.Refresh, Default=刷新}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardContainer}" Margin="0,8,8,4" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Style="{StaticResource QuickCardTitle}"
                                       Text="{utils:Localize KeyPath=OllamaManager.ContextTitle, Default=上下文窗口}"/>
                            <TextBlock Style="{StaticResource QuickHint}"
                                       Text="{utils:Localize KeyPath=OllamaManager.ContextDesc, Default=模型一次能看的文字长度。桌宠的角色设定、插件说明和记忆都要装进去，太小会报“上下文装不下”。}"/>
                            <ComboBox x:Name="Cb_Context" Style="{StaticResource OllamaComboBox}" Width="240" HorizontalAlignment="Left"
                                      Margin="0,12,0,0" SelectionChanged="Context_SelectionChanged"/>
                            <Grid x:Name="Panel_ContextCustom" Width="240" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="Tb_ContextCustom" Style="{StaticResource OllamaTextBox}" KeyDown="ContextCustom_KeyDown"/>
                                <TextBlock Style="{StaticResource OllamaPlaceholder}" Tag="{Binding ElementName=Tb_ContextCustom}"
                                           Text="{utils:Localize KeyPath=OllamaManager.ContextCustomPlaceholder, Default=比如 12288}"/>
                                <Button x:Name="Btn_ContextApply" Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                        Click="ContextApply_Click"
                                        Content="{utils:Localize KeyPath=OllamaManager.ContextApply, Default=应用}"/>
                            </Grid>
                            <TextBlock x:Name="Tb_ContextState" Style="{StaticResource QuickHint}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="Tab_Catalog" Header="{utils:Localize KeyPath=OllamaManager.TabCatalog, Default=推荐模型}">
                <Grid Margin="0,12,0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="Panel_Custom" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="Tb_CustomModel" Style="{StaticResource OllamaTextBox}"/>
                        <TextBlock Style="{StaticResource OllamaPlaceholder}" Tag="{Binding ElementName=Tb_CustomModel}"
                                   Text="{utils:Localize KeyPath=OllamaManager.CustomLabel, Default=其他模型（填 ollama.com 上的名字）}"/>
                        <Button x:Name="Btn_PullCustom" Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="PullCustom_Click"
                                Content="{utils:Localize KeyPath=OllamaManager.Download, Default=下载}"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource OllamaPanel}" Margin="0,0,12,12" Padding="12,12,4,12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" controls:SmoothWheelScroll.Enabled="True">
                                <StackPanel Margin="0,0,6,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}"
                                                   Text="{utils:Localize KeyPath=OllamaManager.LibraryFilters, Default=筛选}"/>
                                        <Button x:Name="Btn_CatalogReset" Grid.Column="1" Style="{StaticResource OllamaChip}" Click="CatalogReset_Click"
                                                Content="{utils:Localize KeyPath=OllamaManager.LibraryReset, Default=重置}"/>
                                    </Grid>

                                    <StackPanel x:Name="Panel_CatalogFit">
                                        <TextBlock Style="{StaticResource OllamaFilterTitle}"
                                                   Text="{utils:Localize KeyPath=OllamaManager.CatalogFit, Default=运行情况}"/>
                                        <ItemsControl x:Name="Items_CatalogFitChips" ItemsPanel="{StaticResource OllamaChipPanel}" ItemTemplate="{StaticResource OllamaChipTemplate}"/>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource OllamaFilterTitle}"
                                               Text="{utils:Localize KeyPath=OllamaManager.LibraryStatus, Default=状态}"/>
                                    <ItemsControl x:Name="Items_CatalogStateChips" ItemsPanel="{StaticResource OllamaChipPanel}" ItemTemplate="{StaticResource OllamaChipTemplate}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource OllamaPanel}" Padding="12,8" Margin="0,0,0,12">
                                <TextBlock x:Name="Tb_CatalogState" Style="{StaticResource QuickHint}" Margin="0" VerticalAlignment="Center"/>
                            </Border>

                            <ScrollViewer x:Name="Scroll_Catalog" Grid.Row="1" VerticalScrollBarVisibility="Auto" SizeChanged="CardScroll_SizeChanged"
                                          controls:SmoothWheelScroll.Enabled="True">
                                <ItemsControl x:Name="Items_Catalog" ItemsPanel="{StaticResource OllamaCardPanel}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource OllamaHighlightCard}">
                                                <StackPanel>
                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource OllamaCardHeader}"/>

                                                    <TextBlock Style="{StaticResource QuickHint}" Margin="0,10,0,0" Height="36" LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" Text="{Binding Description}"/>

                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Style="{StaticResource OllamaStatLabel}"
                                                                       Text="{utils:Localize KeyPath=OllamaManager.LibrarySizeLabel, Default=体积}"/>
                                                            <TextBlock Style="{StaticResource OllamaStatValue}" Text="{Binding Size}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Style="{StaticResource OllamaStatLabel}"
                                                                       Text="{utils:Localize KeyPath=OllamaManager.LibraryStatus, Default=状态}"/>
                                                            <TextBlock Style="{StaticResource OllamaStatValue}" Text="{Binding StateText}"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Border Margin="0,10" Height="1" Background="{StaticResource BorderBrush}"/>

                                                    <Button Style="{StaticResource SecondaryButton}" Margin="0"
                                                            Content="{Binding ActionText}" IsEnabled="{Binding CanAct}" Tag="{Binding}" Click="CatalogAction_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="Tab_Library" Header="{utils:Localize KeyPath=OllamaManager.TabLibrary, Default=模型库}">
                <Grid Margin="0,12,0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <TextBox x:Name="Tb_LibrarySearch" Style="{StaticResource OllamaTextBox}" TextChanged="LibrarySearch_TextChanged"/>
                        <TextBlock Style="{StaticResource OllamaPlaceholder}" Tag="{Binding ElementName=Tb_LibrarySearch}"
                                   Text="{utils:Localize KeyPath=OllamaManager.LibrarySearchHint, Default=搜索模型名称或说明…}"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource OllamaPanel}" Margin="0,0,12,12" Padding="12,12,4,12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" controls:SmoothWheelScroll.Enabled="True">
                                <StackPanel Margin="0,0,6,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}"
                                                   Text="{utils:Localize KeyPath=OllamaManager.LibraryFilters, Default=筛选}"/>
                                        <Button x:Name="Btn_LibraryReset" Grid.Column="1" Style="{StaticResource OllamaChip}" Click="LibraryReset_Click"
                                                Content="{utils:Localize KeyPath=OllamaManager.LibraryReset, Default=重置}"/>
                                    </Grid>

                                    <TextBlock Style="{StaticResource OllamaFilterTitle}"
                                               Text="{utils:Localize KeyPath=OllamaManager.LibraryStatus, Default=状态}"/>
                                    <ItemsControl x:Name="Items_StateChips" ItemsPanel="{StaticResource OllamaChipPanel}" ItemTemplate="{StaticResource OllamaChipTemplate}"/>

                                    <TextBlock Style="{StaticResource OllamaFilterTitle}"
                                               Text="{utils:Localize KeyPath=OllamaManager.LibraryCapability, Default=能力}"/>
                                    <ItemsControl x:Name="Items_CapabilityChips" ItemsPanel="{StaticResource OllamaChipPanel}" ItemTemplate="{StaticResource OllamaChipTemplate}"/>

                                    <TextBlock Style="{StaticResource OllamaFilterTitle}"
                                               Text="{utils:Localize KeyPath=OllamaManager.LibrarySeries, Default=系列}"/>
                                    <ItemsControl x:Name="Items_SeriesChips" ItemsPanel="{StaticResource OllamaChipPanel}" ItemTemplate="{StaticResource OllamaChipTemplate}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource OllamaPanel}" Padding="12,8" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Tb_LibraryState" Style="{StaticResource QuickHint}" Margin="0" VerticalAlignment="Center"/>
                                    <Button x:Name="Btn_LibraryRetry" Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                            Visibility="Collapsed" Click="LibraryRetry_Click"
                                            Content="{utils:Localize KeyPath=OllamaManager.LibraryRetry, Default=重试}"/>
                                    <Border Grid.Column="2" Margin="12,0,0,0" Padding="2" CornerRadius="7" VerticalAlignment="Center" Background="{StaticResource BackgroundBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="Rb_SortPopular" Style="{StaticResource OllamaSegment}" IsChecked="True" Click="LibrarySort_Click"
                                                         Content="{utils:Localize KeyPath=OllamaManager.LibrarySortPopular, Default=热度}"/>
                                            <RadioButton x:Name="Rb_SortName" Style="{StaticResource OllamaSegment}" Click="LibrarySort_Click"
                                                         Content="{utils:Localize KeyPath=OllamaManager.LibrarySortName, Default=名称}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 两百多张卡，按排虚拟化，只生成看得见的。放在 * 行里才有高度，不能再套 ScrollViewer -->
                            <ListBox x:Name="Items_Library" Grid.Row="1" Background="Transparent" BorderThickness="0" SizeChanged="Library_SizeChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Standard"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     controls:SmoothWheelScroll.Enabled="True">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <!-- 列数固定，最后一排不满也和上面对齐 -->
                                                    <UniformGrid Rows="1" Columns="{Binding Columns}"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource OllamaModelCard}" Loaded="LibraryRow_Loaded">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource BackgroundBrush}">
                                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"
                                                                               Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Initial}"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Style="{StaticResource OllamaStatValue}" Margin="0" TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding Name}" Text="{Binding Name}"/>
                                                                    <TextBlock Style="{StaticResource OllamaStatLabel}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                                               Text="{Binding CapabilityText}"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <TextBlock Style="{StaticResource QuickHint}" Margin="0,10,0,0" Height="36" LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" Text="{Binding Description}"/>

                                                            <TextBlock Style="{StaticResource OllamaFitBadge}" Margin="0,8,0,0" MinHeight="16" Text="{Binding FitText}"/>

                                                            <Grid Margin="0,6,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Style="{StaticResource OllamaStatLabel}"
                                                                               Text="{utils:Localize KeyPath=OllamaManager.LibraryPullsLabel, Default=下载量}"/>
                                                                    <TextBlock Style="{StaticResource OllamaStatValue}" Text="{Binding Pulls}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Style="{StaticResource OllamaStatLabel}"
                                                                               Text="{utils:Localize KeyPath=OllamaManager.LibrarySizeLabel, Default=体积}"/>
                                                                    <TextBlock Style="{StaticResource OllamaStatValue}" Text="{Binding SizeText}"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <Border Margin="0,10" Height="1" Background="{StaticResource BorderBrush}"/>

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ComboBox Style="{StaticResource OllamaComboBox}" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" DisplayMemberPath="Text"/>
                                                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                        Content="{Binding Action.Text}" IsEnabled="{Binding Action.Enabled}" Tag="{Binding}" Click="LibraryAction_Click"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{utils:Localize KeyPath=OllamaManager.TabLocal, Default=我的模型}">
                <Grid Margin="0,12,0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <TextBox x:Name="Tb_LocalSearch" Style="{StaticResource OllamaTextBox}" TextChanged="LocalSearch_TextChanged"/>
                        <TextBlock Style="{StaticResource OllamaPlaceholder}" Tag="{Binding ElementName=Tb_LocalSearch}"
                                   Text="{utils:Localize KeyPath=OllamaManager.LocalSearchHint, Default=搜索模型名称…}"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource OllamaPanel}" Margin="0,0,12,12" Padding="12,12,4,12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" controls:SmoothWheelScroll.Enabled="True">
                                <StackPanel Margin="0,0,6,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}"
                                                   Text="{utils:Localize KeyPath=OllamaManager.LibraryFilters, Default=筛选}"/>
                                        <Button x:Name="Btn_LocalReset" Grid.Column="1" Style="{StaticResource OllamaChip}" Click="LocalReset_Click"
                                                Content="{utils:Localize KeyPath=OllamaManager.LibraryReset, Default=重置}"/>
                                    </Grid>

                                    <StackPanel x:Name="Panel_LocalFit">
                                        <TextBlock Style="{StaticResource OllamaFilterTitle}"
                                                   Text="{utils:Localize KeyPath=OllamaManager.CatalogFit, Default=运行情况}"/>
                                        <ItemsControl x:Name="Items_LocalFitChips" ItemsPanel="{StaticResource OllamaChipPanel}" ItemTemplate="{StaticResource OllamaChipTemplate}"/>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource OllamaFilterTitle}"
                                               Text="{utils:Localize KeyPath=OllamaManager.LocalPurpose, Default=用途}"/>
                                    <ItemsControl x:Name="Items_LocalPurposeChips" ItemsPanel="{StaticResource OllamaChipPanel}" ItemTemplate="{StaticResource OllamaChipTemplate}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource OllamaPanel}" Padding="12,8" Margin="0,0,0,12">
                                <TextBlock x:Name="Tb_LocalState" Style="{StaticResource QuickHint}" Margin="0" VerticalAlignment="Center"/>
                            </Border>

                            <ScrollViewer x:Name="Scroll_Local" Grid.Row="1" VerticalScrollBarVisibility="Auto" SizeChanged="CardScroll_SizeChanged"
                                          controls:SmoothWheelScroll.Enabled="True">
                                <ItemsControl x:Name="Items_Local" ItemsPanel="{StaticResource OllamaCardPanel}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource OllamaHighlightCard}">
                                                <StackPanel>
                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource OllamaCardHeader}"/>

                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Style="{StaticResource OllamaStatLabel}"
                                                                       Text="{utils:Localize KeyPath=OllamaManager.LibrarySizeLabel, Default=体积}"/>
                                                            <TextBlock Style="{StaticResource OllamaStatValue}" Text="{Binding Size}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Style="{StaticResource OllamaStatLabel}"
                                                                       Text="{utils:Localize KeyPath=OllamaManager.LibrarySeries, Default=系列}"/>
                                                            <TextBlock Style="{StaticResource OllamaStatValue}" TextTrimming="CharacterEllipsis" Text="{Binding Series}"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Border Margin="0,10" Height="1" Background="{StaticResource BorderBrush}"/>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"
                                                                Content="{Binding UseText}" IsEnabled="{Binding CanUse}" Tag="{Binding}" Click="UseModel_Click"/>
                                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0"
                                                                Content="{utils:Localize KeyPath=OllamaManager.Delete, Default=删除}" Tag="{Binding}" Click="DeleteModel_Click"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid x:Name="Panel_Progress" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Tb_TaskTitle" Style="{StaticResource QuickGuideLine}"/>
                <ProgressBar x:Name="Bar_Task" Height="6" Margin="0,6,0,4" Maximum="100"
                             Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock x:Name="Tb_TaskDetail" Style="{StaticResource QuickHint}"/>
            </StackPanel>
            <Button x:Name="Btn_Cancel" Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                    VerticalAlignment="Center" Click="Cancel_Click"
                    Content="{utils:Localize KeyPath=OllamaManager.Cancel, Default=取消}"/>

            <!-- 下载慢时才出现：安装包问要不要走代理，模型给断开重连 -->
            <Border x:Name="Panel_Slow" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Padding="12,10"
                    CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource WarningBrush}"
                    Background="{StaticResource SecondaryBackgroundBrush}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="Tb_SlowHint" Style="{StaticResource QuickGuideLine}" TextWrapping="Wrap"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="Panel_Proxy">
                            <TextBox x:Name="Tb_Proxy" Style="{StaticResource OllamaTextBox}"/>
                            <TextBlock Style="{StaticResource OllamaPlaceholder}" Tag="{Binding ElementName=Tb_Proxy}"
                                       Text="{utils:Localize KeyPath=OllamaManager.ProxyPlaceholder, Default=代理地址，例如 http://127.0.0.1:7890}"/>
                        </Grid>
                        <Button x:Name="Btn_DetectProxy" Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Click="DetectProxy_Click" Content="{utils:Localize KeyPath=OllamaManager.DetectProxy, Default=自动检测}"/>
                        <Button x:Name="Btn_UseProxy" Grid.Column="2" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                Click="UseProxy_Click" Content="{utils:Localize KeyPath=OllamaManager.UseProxy, Default=使用代理}"/>
                        <Button x:Name="Btn_Reconnect" Style="{StaticResource PrimaryButton}" Margin="0"
                                HorizontalAlignment="Left" Click="Reconnect_Click"
                                Content="{utils:Localize KeyPath=OllamaManager.Reconnect, Default=断开重连}"/>
                        <Button x:Name="Btn_SlowDismiss" Grid.Column="3" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Click="SlowDismiss_Click" Content="{utils:Localize KeyPath=OllamaManager.SlowDismiss, Default=不用了}"/>
                    </Grid>
                    <TextBlock x:Name="Tb_ProxyFound" Style="{StaticResource QuickGuideLine}" TextWrapping="Wrap"
                               Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="Tb_Status" Grid.Row="4" Style="{StaticResource QuickGuideLine}" Margin="0,10,0,0" Visibility="Collapsed"/>
    </Grid>
</Window>

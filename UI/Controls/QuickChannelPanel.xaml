<UserControl x:Class="VPetLLM.UI.Controls.QuickChannelPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utils="clr-namespace:VPetLLM.Utils.Localization">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/QuickSetup.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <RadioButton x:Name="Rb_Free" Style="{StaticResource QuickCardRadio}" Checked="Mode_Checked">
            <StackPanel>
                <TextBlock Style="{StaticResource QuickCardTitle}"
                           Text="{utils:Localize KeyPath=QuickSetup.FreeTitle, Default=免费体验（推荐）}"/>
                <TextBlock Style="{StaticResource QuickHint}"
                           Text="{utils:Localize KeyPath=QuickSetup.FreeDesc, Default=不用注册，也不用填写任何东西，选中就能开始聊天。}"/>
                <TextBlock x:Name="Tb_FreeInfo" Style="{StaticResource QuickHint}" Visibility="Collapsed"/>
            </StackPanel>
        </RadioButton>

        <RadioButton x:Name="Rb_ApiKey" Style="{StaticResource QuickCardRadio}" Checked="Mode_Checked">
            <StackPanel>
                <TextBlock Style="{StaticResource QuickCardTitle}"
                           Text="{utils:Localize KeyPath=QuickSetup.ApiKeyTitle, Default=我有 API Key}"/>
                <TextBlock Style="{StaticResource QuickHint}"
                           Text="{utils:Localize KeyPath=QuickSetup.ApiKeyDesc, Default=使用自己购买的 AI 服务，回复质量和速度由所选服务决定。}"/>
            </StackPanel>
        </RadioButton>

        <StackPanel x:Name="Panel_ApiKey" Visibility="Collapsed" Margin="30,0,0,12">
            <TextBlock Style="{StaticResource QuickFieldLabel}"
                       Text="{utils:Localize KeyPath=QuickSetup.ProviderLabel, Default=服务商}"/>
            <ComboBox x:Name="Cb_Preset" Style="{StaticResource ModernComboBox}" SelectionChanged="Preset_SelectionChanged"/>

            <StackPanel x:Name="Panel_CustomUrl" Visibility="Collapsed">
                <TextBlock Style="{StaticResource QuickFieldLabel}"
                           Text="{utils:Localize KeyPath=QuickSetup.UrlLabel, Default=接口地址}"/>
                <TextBox x:Name="Tb_Url" Style="{StaticResource ModernTextBox}" TextChanged="Url_TextChanged"/>
            </StackPanel>

            <TextBlock Style="{StaticResource QuickFieldLabel}"
                       Text="{utils:Localize KeyPath=QuickSetup.KeyLabel, Default=API Key}"/>
            <PasswordBox x:Name="Pb_ApiKey" Style="{StaticResource QuickPasswordBox}" PasswordChanged="Field_Changed"/>
            <TextBlock x:Name="Tb_KeySaved" Style="{StaticResource QuickHint}" Visibility="Collapsed"
                       Text="{utils:Localize KeyPath=QuickSetup.KeySaved, Default=这个服务已经保存过 API Key，留空就继续使用它。}"/>

            <TextBlock Style="{StaticResource QuickFieldLabel}"
                       Text="{utils:Localize KeyPath=QuickSetup.ModelLabel, Default=模型}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="Cb_Model" Style="{StaticResource ModelComboBox}" IsEditable="True"
                          TextBoxBase.TextChanged="ModelText_Changed"/>
                <Button x:Name="Btn_FetchModels" Grid.Column="1" Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="FetchModels_Click"
                        Content="{utils:Localize KeyPath=QuickSetup.FetchModels, Default=获取模型}"/>
            </Grid>

            <TextBlock Style="{StaticResource QuickHint}" Margin="0,8,0,0"
                       Text="{utils:Localize KeyPath=QuickSetup.ApiKeyMore, Default=这里支持 OpenAI 格式的服务。Gemini 或多个渠道备用，请到极客界面里配置。}"/>
        </StackPanel>

        <RadioButton x:Name="Rb_Local" Style="{StaticResource QuickCardRadio}" Checked="Mode_Checked">
            <StackPanel>
                <TextBlock Style="{StaticResource QuickCardTitle}"
                           Text="{utils:Localize KeyPath=QuickSetup.LocalTitle, Default=本地模型}"/>
                <TextBlock Style="{StaticResource QuickHint}"
                           Text="{utils:Localize KeyPath=QuickSetup.LocalDesc, Default=使用电脑上已经运行的 Ollama 或 LM Studio，对话不离开这台电脑。}"/>
            </StackPanel>
        </RadioButton>

        <StackPanel x:Name="Panel_Local" Visibility="Collapsed" Margin="30,0,0,12">
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <RadioButton x:Name="Rb_Ollama" Style="{StaticResource ModernRadioButton}" Margin="0,0,24,0"
                             Content="Ollama" Checked="LocalKind_Checked"/>
                <RadioButton x:Name="Rb_LMStudio" Style="{StaticResource ModernRadioButton}"
                             Content="LM Studio" Checked="LocalKind_Checked"/>
            </StackPanel>

            <TextBlock Style="{StaticResource QuickFieldLabel}"
                       Text="{utils:Localize KeyPath=QuickSetup.UrlLabel, Default=接口地址}"/>
            <TextBox x:Name="Tb_LocalUrl" Style="{StaticResource ModernTextBox}" TextChanged="Field_Changed"/>

            <TextBlock Style="{StaticResource QuickFieldLabel}"
                       Text="{utils:Localize KeyPath=QuickSetup.ModelLabel, Default=模型}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="Cb_LocalModel" Style="{StaticResource ModelComboBox}" IsEditable="True"
                          TextBoxBase.TextChanged="ModelText_Changed"/>
                <Button x:Name="Btn_FetchLocalModels" Grid.Column="1" Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="FetchModels_Click"
                        Content="{utils:Localize KeyPath=QuickSetup.FetchModels, Default=获取模型}"/>
            </Grid>
        </StackPanel>

        <TextBlock x:Name="Tb_Status" Style="{StaticResource QuickGuideLine}" Margin="0,4,0,0" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>

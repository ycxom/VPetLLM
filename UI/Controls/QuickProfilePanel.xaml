<UserControl x:Class="VPetLLM.UI.Controls.QuickProfilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utils="clr-namespace:VPetLLM.Utils.Localization">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/QuickSetup.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <CheckBox x:Name="Cb_FollowName" Style="{StaticResource ModernCheckBox}"
                  Checked="FollowName_Changed" Unchecked="FollowName_Changed"
                  Content="{utils:Localize KeyPath=QuickSetup.FollowName, Default=使用桌宠存档里的名字和称呼}"/>

        <TextBlock Style="{StaticResource QuickFieldLabel}"
                   Text="{utils:Localize KeyPath=QuickSetup.PetName, Default=桌宠的名字}"/>
        <TextBox x:Name="Tb_AiName" Style="{StaticResource ModernTextBox}"/>

        <TextBlock Style="{StaticResource QuickFieldLabel}"
                   Text="{utils:Localize KeyPath=QuickSetup.UserName, Default=它怎么称呼你}"/>
        <TextBox x:Name="Tb_UserName" Style="{StaticResource ModernTextBox}"/>

        <TextBlock Style="{StaticResource QuickFieldLabel}"
                   Text="{utils:Localize KeyPath=QuickSetup.Personality, Default=性格}"/>
        <ComboBox x:Name="Cb_Personality" Style="{StaticResource ModernComboBox}"
                  SelectionChanged="Personality_SelectionChanged">
            <ComboBoxItem Tag="keep" Content="{utils:Localize KeyPath=QuickSetup.PersonalityKeep, Default=保持现在的设定}"/>
            <ComboBoxItem Tag="lively" Content="{utils:Localize KeyPath=QuickSetup.PersonalityLively, Default=活泼可爱}"/>
            <ComboBoxItem Tag="gentle" Content="{utils:Localize KeyPath=QuickSetup.PersonalityGentle, Default=温柔体贴}"/>
            <ComboBoxItem Tag="tsundere" Content="{utils:Localize KeyPath=QuickSetup.PersonalityTsundere, Default=傲娇}"/>
        </ComboBox>

        <TextBox x:Name="Tb_Role" Style="{StaticResource ModernTextBox}" Margin="0,8,0,0"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="96"
                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
        <TextBlock Style="{StaticResource QuickHint}"
                   Text="{utils:Localize KeyPath=QuickSetup.RoleHint, Default=这段话告诉 AI 该怎么扮演桌宠，可以随意修改。}"/>
    </StackPanel>
</UserControl>
